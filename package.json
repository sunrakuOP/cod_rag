{
  "name": "cod_rag",
  "version": "1.0.0",
  "description": "Monorepo de trabajo. Reúne **el negocio** (oferta de automatización COD que se construye y se vende) y **el estudio** (ruta AI Engineer hacia empleo remoto). Objetivo: fuente de ingreso ≥ USD 2.000/mes para diciembre 2026.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up --migrations-dir src/db/migrations",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down --migrations-dir src/db/migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir src/db/migrations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bullmq": "^6.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
