NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://cod_rag:cod_rag@localhost:5432/cod_rag
REDIS_URL=redis://localhost:6379

# Shopify Admin > Settings > Notifications > Webhooks (signing secret shown
# once a webhook exists), or your custom app's client secret.
SHOPIFY_WEBHOOK_SECRET=

# Meta for Developers app > WhatsApp > API Setup. Access token here is
# whatever's currently active (temporary user token today, a System User
# permanent token once set up). Phone number ID is the *real* Dovi number,
# not the free sandbox test number.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
